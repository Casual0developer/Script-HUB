-- ==================== ANTI-FLING ====================
-- Watches assemblies around the local character instead of only watching
-- other players. This also covers loose parts, vehicles, seats and chairs.
if _G.ClientAdminAntiFlingCleanup then
    pcall(_G.ClientAdminAntiFlingCleanup)
    _G.ClientAdminAntiFlingCleanup = nil
end

local ANTI_FLING_SCAN_RADIUS       = 140
local ANTI_FLING_DANGER_RADIUS     = 42
local ANTI_FLING_LINEAR_LIMIT      = 95
local ANTI_FLING_ANGULAR_LIMIT     = 32
local ANTI_FLING_TELEPORT_LIMIT    = 145
local ANTI_FLING_SEAT_LINEAR_LIMIT = 55
local ANTI_FLING_SEAT_ANGULAR_LIMIT = 12
local ANTI_FLING_QUARANTINE_TIME   = 4
local ANTI_FLING_EMERGENCY_SPEED   = 75
local ANTI_FLING_MAX_SAFE_DROP     = 140
local ANTI_FLING_VOID_MARGIN       = 90

local antiFlingSamples = setmetatable({}, {__mode = "k"})
local antiFlingQuarantine = setmetatable({}, {__mode = "k"})
local antiFlingSafeCFrame = nil
local antiFlingAccumulator = 0
local antiFlingLastWarning = 0
local antiFlingSavedFPDH = nil
local antiFlingLastRootPosition = nil
local antiFlingLastRootTime = nil
local antiFlingCharacter = nil
local antiFlingRecoveryUntil = 0
local antiFlingSafeHealth = nil
local antiFlingCharacterTouches = setmetatable({}, {__mode = "k"})

local function isSeatPart(part)
    return part and (part:IsA("Seat") or part:IsA("VehicleSeat"))
end

local function restoreQuarantinedPart(part, data)
    if not part or not part.Parent then return end
    pcall(function()
        part.CanCollide = data.CanCollide
        part.CanTouch = data.CanTouch
    end)
end

local function clearAntiFlingQuarantine()
    for part, data in pairs(antiFlingQuarantine) do
        restoreQuarantinedPart(part, data)
        antiFlingQuarantine[part] = nil
    end
end

local function setCharacterTouchShield(character, enabled)
    if enabled then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                if antiFlingCharacterTouches[object] == nil then
                    antiFlingCharacterTouches[object] = object.CanTouch
                end
                pcall(function() object.CanTouch = false end)
            end
        end
        return
    end

    for part, oldCanTouch in pairs(antiFlingCharacterTouches) do
        if part and part.Parent then
            pcall(function() part.CanTouch = oldCanTouch end)
        end
        antiFlingCharacterTouches[part] = nil
    end
end

local function quarantinePart(part, duration)
    if not part or not part:IsA("BasePart") then return end

    local data = antiFlingQuarantine[part]
    if not data then
        data = {
            CanCollide = part.CanCollide,
            CanTouch = part.CanTouch,
            Expires = 0,
        }
        antiFlingQuarantine[part] = data
    end

    data.Expires = math.max(data.Expires, os.clock() + (duration or ANTI_FLING_QUARANTINE_TIME))
    pcall(function()
        part.CanCollide = false
        part.CanTouch = false
    end)
end

local function quarantineAssembly(part)
    quarantinePart(part)

    local ok, connected = pcall(function()
        return part:GetConnectedParts(true)
    end)
    if not ok then return end

    for index, connectedPart in ipairs(connected) do
        if index > 96 then break end
        quarantinePart(connectedPart)
    end
end

local function breakLocalSeatWeld(character, seatPart)
    if seatPart then
        local seatWeld = seatPart:FindFirstChild("SeatWeld")
        if seatWeld and seatWeld:IsA("Weld") then
            pcall(function() seatWeld:Destroy() end)
        end
    end

    for _, object in ipairs(character:GetDescendants()) do
        if object.Name == "SeatWeld" and (object:IsA("Weld") or object:IsA("WeldConstraint")) then
            pcall(function() object:Destroy() end)
        end
    end
end

local function stopCharacterFling(character, humanoid, root, dangerousPart)
    antiFlingRecoveryUntil = math.max(antiFlingRecoveryUntil, os.clock() + 0.45)
    setCharacterTouchShield(character, true)
    local seatPart = humanoid.SeatPart
    humanoid.Sit = false
    humanoid.PlatformStand = false
    breakLocalSeatWeld(character, seatPart)
    pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            pcall(function()
                object.AssemblyLinearVelocity = Vector3.zero
                object.AssemblyAngularVelocity = Vector3.zero
                object.Velocity = Vector3.zero
                object.RotVelocity = Vector3.zero
            end)
        end
    end

    if dangerousPart then
        quarantineAssembly(dangerousPart)
    end
    if seatPart and seatPart ~= dangerousPart then
        quarantineAssembly(seatPart)
    end

    if antiFlingSafeCFrame then
        pcall(function()
            root.CFrame = antiFlingSafeCFrame
        end)
    end
end

local function sampleDangerousPart(part, now, rootPosition, seatedOn)
    local assembly = part.AssemblyRootPart or part
    if not assembly or not assembly.Parent then return false, nil end

    local distance = (part.Position - rootPosition).Magnitude
    local linearSpeed = assembly.AssemblyLinearVelocity.Magnitude
    local angularSpeed = assembly.AssemblyAngularVelocity.Magnitude
    local seatRelated = isSeatPart(part) or isSeatPart(assembly) or seatedOn == part or seatedOn == assembly
    local sample = antiFlingSamples[assembly]
    local estimatedSpeed = 0
    local displacement = 0

    if sample then
        local elapsed = math.max(now - sample.Time, 1 / 240)
        displacement = (assembly.Position - sample.Position).Magnitude
        estimatedSpeed = displacement / elapsed
    end
    antiFlingSamples[assembly] = {Position = assembly.Position, Time = now}

    local linearLimit = seatRelated and ANTI_FLING_SEAT_LINEAR_LIMIT or ANTI_FLING_LINEAR_LIMIT
    local angularLimit = seatRelated and ANTI_FLING_SEAT_ANGULAR_LIMIT or ANTI_FLING_ANGULAR_LIMIT
    local teleportLimit = seatRelated and 75 or ANTI_FLING_TELEPORT_LIMIT
    local teleported = sample and displacement >= (seatRelated and 4 or 7) and estimatedSpeed >= teleportLimit
    local movingDangerously = linearSpeed >= linearLimit or angularSpeed >= angularLimit or teleported

    -- A newly arrived unanchored object almost touching the character may have
    -- been CFramed there, which can report zero velocity on its first frame.
    local suspiciousArrival = not sample
        and not assembly.Anchored
        and distance <= (seatRelated and 10 or 5.5)
        and (seatRelated or assembly.Size.Magnitude >= 3)

    return (movingDangerously or suspiciousArrival) and distance <= ANTI_FLING_DANGER_RADIUS, assembly
end

local function antiFlingStep(deltaTime)
    if not antiFling then return end

    local now = os.clock()

    -- Keep Roblox's local fallen-part boundary disabled while protected. The
    -- emergency position checks below still move the character back, but this
    -- prevents the boundary from deleting the character first on a huge fling.
    pcall(function()
        local destroyHeight = Workspace.FallenPartsDestroyHeight
        if destroyHeight == destroyHeight then
            Workspace.FallenPartsDestroyHeight = 0 / 0
        end
    end)

    for part, data in pairs(antiFlingQuarantine) do
        if not part.Parent or now >= data.Expires then
            restoreQuarantinedPart(part, data)
            antiFlingQuarantine[part] = nil
        else
            pcall(function()
                part.CanCollide = false
                part.CanTouch = false
            end)
        end
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not (character and humanoid and root) then return end

    if antiFlingCharacter ~= character then
        setCharacterTouchShield(character, false)
        antiFlingCharacter = character
        antiFlingSafeCFrame = root.CFrame
        antiFlingLastRootPosition = root.Position
        antiFlingLastRootTime = now
        antiFlingSafeHealth = humanoid.Health
        antiFlingRecoveryUntil = 0
    end

    if now < antiFlingRecoveryUntil then
        setCharacterTouchShield(character, true)
        humanoid.Sit = false
        humanoid.PlatformStand = false
        pcall(function()
            if root.AssemblyLinearVelocity.Magnitude > 55 then
                root.AssemblyLinearVelocity = Vector3.zero
            end
            if root.AssemblyAngularVelocity.Magnitude > 12 then
                root.AssemblyAngularVelocity = Vector3.zero
            end
            if antiFlingSafeHealth and humanoid.Health > 0 and humanoid.Health < antiFlingSafeHealth then
                humanoid.Health = math.min(humanoid.MaxHealth, antiFlingSafeHealth)
            end
        end)
    elseif next(antiFlingCharacterTouches) ~= nil then
        setCharacterTouchShield(character, false)
    end

    local rootSpeed = root.AssemblyLinearVelocity.Magnitude
    local rootSpin = root.AssemblyAngularVelocity.Magnitude
    local rootPosition = root.Position
    local elapsed = antiFlingLastRootTime and math.max(now - antiFlingLastRootTime, 1 / 240) or nil
    local frameDrop = antiFlingLastRootPosition and (antiFlingLastRootPosition.Y - rootPosition.Y) or 0
    local frameDisplacement = antiFlingLastRootPosition and (rootPosition - antiFlingLastRootPosition).Magnitude or 0
    local estimatedDropSpeed = elapsed and frameDrop / elapsed or 0
    local estimatedMovementSpeed = elapsed and frameDisplacement / elapsed or 0
    local rootVelocity = root.AssemblyLinearVelocity
    local horizontalSpeed = Vector3.new(rootVelocity.X, 0, rootVelocity.Z).Magnitude
    local safeY = antiFlingSafeCFrame and antiFlingSafeCFrame.Position.Y or rootPosition.Y
    local savedDestroyHeight = antiFlingSavedFPDH
    local nearVoid = savedDestroyHeight
        and savedDestroyHeight == savedDestroyHeight
        and rootPosition.Y <= savedDestroyHeight + ANTI_FLING_VOID_MARGIN
    local farBelowSafePoint = antiFlingSafeCFrame
        and rootPosition.Y <= safeY - ANTI_FLING_MAX_SAFE_DROP
    local suddenDownwardTeleport = frameDrop >= 14 and estimatedDropSpeed >= 140
    local suddenExternalTeleport = now >= antiFlingOwnTeleportGraceUntil
        and frameDisplacement >= 6
        and estimatedMovementSpeed >= 105
    -- Ordinary falling can eventually become fast, so downward Y velocity by
    -- itself is not a fling. Horizontal launches, violent upward launches and
    -- extreme downward launches are handled separately.
    local extremeVelocity = horizontalSpeed >= ANTI_FLING_EMERGENCY_SPEED
        or rootVelocity.Y >= 110
        or rootVelocity.Y <= -220
        or rootSpin >= 38

    antiFlingLastRootPosition = rootPosition
    antiFlingLastRootTime = now

    -- This path deliberately runs every rendered physics frame, before the
    -- heavier nearby-part scan, so a launch toward the void is undone at once.
    if nearVoid or farBelowSafePoint or suddenDownwardTeleport or suddenExternalTeleport or extremeVelocity then
        stopCharacterFling(character, humanoid, root, nil)
        antiFlingLastRootPosition = root.Position
        antiFlingLastRootTime = now
        if now - antiFlingLastWarning >= 1.25 then
            antiFlingLastWarning = now
            notify((nearVoid or farBelowSafePoint) and "AntiFling rescued you from the void" or "AntiFling stopped a fast launch")
        end
        return
    end

    antiFlingAccumulator += deltaTime
    if antiFlingAccumulator < 0.025 then return end
    antiFlingAccumulator = 0

    local healthyMovement = not humanoid.Sit
        and humanoid.FloorMaterial ~= Enum.Material.Air
        and rootSpeed < 24
        and rootSpin < 7

    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = {character}
    overlap.MaxParts = 512

    local nearbyParts = Workspace:GetPartBoundsInRadius(root.Position, ANTI_FLING_SCAN_RADIUS, overlap)
    local dangerousPart = nil
    local dangerousAssemblies = {}
    local newlyDetectedCloseThreat = false
    local seatedOn = humanoid.SeatPart

    for _, part in ipairs(nearbyParts) do
        if part:IsA("BasePart") then
            local dangerous, assembly = sampleDangerousPart(part, now, root.Position, seatedOn)
            if dangerous then
                local threat = assembly or part
                dangerousPart = dangerousPart or threat
                local threatDistance = (part.Position - root.Position).Magnitude
                if not dangerousAssemblies[threat] then
                    dangerousAssemblies[threat] = true
                    if antiFlingQuarantine[threat] == nil and threatDistance <= 9 then
                        newlyDetectedCloseThreat = true
                    end
                    quarantineAssembly(threat)
                end
            end
        end
    end

    if seatedOn and not dangerousPart then
        local dangerous, assembly = sampleDangerousPart(seatedOn, now, root.Position, seatedOn)
        if dangerous then dangerousPart = assembly or seatedOn end
    end

    -- A large unexplained local velocity is treated as a fling even if the
    -- attacking object moved away before this scan ran.
    local currentVelocity = root.AssemblyLinearVelocity
    local currentHorizontalSpeed = Vector3.new(currentVelocity.X, 0, currentVelocity.Z).Magnitude
    local characterAlreadyFlinging = currentHorizontalSpeed >= ANTI_FLING_EMERGENCY_SPEED
        or currentVelocity.Y >= 110
        or currentVelocity.Y <= -220
        or root.AssemblyAngularVelocity.Magnitude >= 38
    local suspiciousMotionNearThreat = dangerousPart and (
        currentHorizontalSpeed >= 45
        or currentVelocity.Y >= 65
        or currentVelocity.Y <= -120
        or root.AssemblyAngularVelocity.Magnitude >= 14
    )
    local seatedInThreat = seatedOn and dangerousPart ~= nil
    local tookDamageNearThreat = dangerousPart
        and antiFlingSafeHealth
        and humanoid.Health > 0
        and humanoid.Health < antiFlingSafeHealth
    local shouldRecover = characterAlreadyFlinging
        or suspiciousMotionNearThreat
        or seatedInThreat
        or newlyDetectedCloseThreat
        or tookDamageNearThreat

    if shouldRecover then
        stopCharacterFling(character, humanoid, root, dangerousPart)
        if now - antiFlingLastWarning >= 1.5 then
            antiFlingLastWarning = now
            notify(dangerousPart and "AntiFling blocked a dangerous moving object" or "AntiFling stopped abnormal character velocity")
        end
    elseif healthyMovement and not dangerousPart then
        -- Only advance the recovery point after the area has passed the threat
        -- scan, so a teleported chair cannot replace the last safe position.
        antiFlingSafeCFrame = root.CFrame
        antiFlingSafeHealth = humanoid.Health
    end
end

startAntiFling = function(silent)
    if FlingActive or FlingWorkerRunning then
        antiFlingResumeAfterFling = true
        if not silent then notify("AntiFling will enable when flinging stops") end
        return
    end
    if antiFling then
        if not silent then notify("AntiFling is already enabled") end
        return
    end
    antiFling = true
    antiFlingAccumulator = 0
    antiFlingLastWarning = 0
    local root = getRoot()
    antiFlingCharacter = LocalPlayer.Character
    antiFlingSafeCFrame = root and root.CFrame or nil
    antiFlingLastRootPosition = root and root.Position or nil
    antiFlingLastRootTime = os.clock()
    antiFlingSafeHealth = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        and LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health or nil
    antiFlingRecoveryUntil = 0
    antiFlingSavedFPDH = Workspace.FallenPartsDestroyHeight
    pcall(function()
        Workspace.FallenPartsDestroyHeight = 0 / 0
    end)

    if antiFlingConn then antiFlingConn:Disconnect() end
    -- PreSimulation runs before the physics step, allowing dangerous parts to
    -- be made non-collidable before their next contact can launch the player.
    antiFlingConn = RunService.PreSimulation:Connect(antiFlingStep)
    if not silent then
        notify("AntiFling enabled: protecting against fast, spinning and teleporting parts")
    end
end

stopAntiFling = function(silent, preserveResume)
    if not preserveResume then
        antiFlingResumeAfterFling = false
    end
    antiFling = false
    if antiFlingConn then
        antiFlingConn:Disconnect()
        antiFlingConn = nil
    end
    clearAntiFlingQuarantine()
    setCharacterTouchShield(LocalPlayer.Character, false)
    table.clear(antiFlingSamples)
    if antiFlingSavedFPDH ~= nil then
        pcall(function()
            Workspace.FallenPartsDestroyHeight = antiFlingSavedFPDH
        end)
    end
    antiFlingSavedFPDH = nil
    antiFlingSafeCFrame = nil
    antiFlingLastRootPosition = nil
    antiFlingLastRootTime = nil
    antiFlingCharacter = nil
    antiFlingSafeHealth = nil
    antiFlingRecoveryUntil = 0
    if not silent then notify("AntiFling disabled") end
end

_G.ClientAdminAntiFlingCleanup = function()
    stopAntiFling(true)
end

