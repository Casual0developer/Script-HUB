local aliases = {
    cmds = "cmd",
    help = "cmd",
    menu = "cmd",

    nc = "noclip",
    clip = "unnoclip",

    ij = "infinitejump",
    unij = "uninfinitejump",

    ws = "speed",
    walkspeed = "speed",
    jp = "jump",
    jumppower = "jump",

    goto = "tp",
    position = "pos",
    reset = "die",

    fb = "fullbright",
    unfb = "unfullbright",

    af = "antifling",
    unaf = "unantifling",
}

local function joinArgs(args, first)
    if #args < first then return nil end
    return table.concat(args, " ", first)
end

local function toggleNoclip()
    if noclip then stopNoclip() else startNoclip() end
end

local function toggleFly()
    if flying then stopFly() else startFly() end
end

local function toggleESP()
    if espEnabled then disableESP() else enableESP() end
end

local function toggleGod()
    if godMode then stopGodMode() else startGodMode() end
end

local function toggleFullbright()
    if fullbright then disableFullbright() else enableFullbright() end
end

local function toggleInfiniteJump()
    infiniteJump = not infiniteJump
    notify("Infinite Jump " .. (infiniteJump and "enabled" or "disabled"))
end

local function handleCommand(msg)
    if type(msg) ~= "string" then return end

    msg = msg:match("^%s*(.-)%s*$") or ""
    if msg:sub(1, #prefix) ~= prefix then return end

    -- Global duplicate guard. This prevents the same outgoing chat message from
    -- being handled more than once if a chat API happens to emit it repeatedly.
    local normalized = msg:lower()
    local now = os.clock()
    if commandDebounce.text == normalized and (now - commandDebounce.time) < 0.45 then
        return
    end
    commandDebounce.text = normalized
    commandDebounce.time = now

    local body = msg:sub(#prefix + 1):match("^%s*(.-)%s*$") or ""
    local args = {}
    for w in body:gmatch("%S+") do
        table.insert(args, w)
    end

    local cmd = args[1] and args[1]:lower() or ""
    if cmd == "" then return end
    cmd = aliases[cmd] or cmd

    if cmd == "fly" then
        local newSpeed = tonumber(args[2])
        if newSpeed then
            flySpeed = math.clamp(newSpeed, 1, 1000)
            if flying then
                notify("Fly speed updated to " .. tostring(flySpeed))
            else
                startFly()
            end
        else
            startFly()
        end

    elseif cmd == "unfly" then
        stopFly()
    elseif cmd == "togglefly" then
        toggleFly()

    elseif cmd == "noclip" then
        startNoclip()
    elseif cmd == "unnoclip" then
        stopNoclip()
    elseif cmd == "togglenoclip" then
        toggleNoclip()

    elseif cmd == "infinitejump" then
        if infiniteJump then notify("Infinite Jump already enabled")
        else infiniteJump = true notify("Infinite Jump enabled") end
    elseif cmd == "uninfinitejump" then
        if not infiniteJump then notify("Infinite Jump already disabled")
        else infiniteJump = false notify("Infinite Jump disabled") end
    elseif cmd == "toggleij" then
        toggleInfiniteJump()

    elseif cmd == "spin" then
        startSpin(tonumber(args[2]) or spinSpeed)
    elseif cmd == "unspin" then
        stopSpin()

    elseif cmd == "esp" then
        enableESP()
    elseif cmd == "unesp" then
        disableESP()
    elseif cmd == "toggleesp" then
        toggleESP()

    elseif cmd == "godmode" then
        startGodMode()
    elseif cmd == "ungodmode" then
        stopGodMode()
    elseif cmd == "togglegod" then
        toggleGod()

    elseif cmd == "fullbright" then
        enableFullbright()
    elseif cmd == "unfullbright" then
        disableFullbright()
    elseif cmd == "togglefb" then
        toggleFullbright()

    elseif cmd == "speed" then
        local n = tonumber(args[2])
        if n then
            desiredWalkSpeed = n
            local hum = getHumanoid()
            if hum then
                hum.WalkSpeed = desiredWalkSpeed
                notify("WalkSpeed set to " .. tostring(desiredWalkSpeed) .. " | persists after reset")
            else
                notify("WalkSpeed saved as " .. tostring(desiredWalkSpeed) .. " and will apply on spawn")
            end
        else
            notify("Usage: " .. prefix .. "speed <number>")
        end

    elseif cmd == "jump" then
        local n = tonumber(args[2])
        if n then setJumpPower(n)
        else notify("Usage: " .. prefix .. "jump <number>") end

    elseif cmd == "tp" then
        local who = joinArgs(args, 2)
        if who then tpToPlayer(who)
        else notify("Usage: " .. prefix .. "tp <player>") end

    elseif cmd == "thru" then
        thru()

    elseif cmd == "sit" then
        setSit(true)
    elseif cmd == "unsit" then
        setSit(false)

    elseif cmd == "freeze" then
        setFrozen(true)
    elseif cmd == "unfreeze" then
        setFrozen(false)

    elseif cmd == "fov" then
        setFov(args[2])
    elseif cmd == "unfov" then
        resetFov()

    elseif cmd == "gravity" then
        setGravity(args[2])
    elseif cmd == "ungravity" then
        resetGravity()

    elseif cmd == "view" then
        local who = joinArgs(args, 2)
        if who then viewPlayer(who)
        else notify("Usage: " .. prefix .. "view <player>") end
    elseif cmd == "unview" then
        unviewPlayer()

    elseif cmd == "pos" then
        showPosition()

    elseif cmd == "block" then
        local who = joinArgs(args, 2)
        if who then blockPlayer(who)
        else notify("Usage: " .. prefix .. "block <player>") end
    elseif cmd == "unblock" then
        local who = joinArgs(args, 2)
        if who then unblockPlayer(who)
        else notify("Usage: " .. prefix .. "unblock <player>") end

    elseif cmd == "antifling" then
        startAntiFling()
    elseif cmd == "unantifling" then
        stopAntiFling(false)

    elseif cmd == "fling" then
        showFlingGUI()
    elseif cmd == "serverhop" then
        showServerHopGUI()
    elseif cmd == "rejoin" then
        rejoinServer()
    elseif cmd == "back" then
        back()
    elseif cmd == "die" then
        die()

    elseif cmd == "cmd" then
        showCommandsGUI()

    else
        notify("Unknown command: " .. cmd .. " | Type " .. prefix .. "cmd")
    end
end

-- Use ONE stored chat connection. The previous version used OnIncomingMessage,
-- which can process a local outgoing message more than once on some chat paths.
-- Storing the connection also lets a re-run of this updated script clean up its
-- previous listener instead of stacking another command handler.
if _G.ClientAdminCommandConnection then
    pcall(function()
        _G.ClientAdminCommandConnection:Disconnect()
    end)
    _G.ClientAdminCommandConnection = nil
end

_G.ClientAdminCommandConnection = LocalPlayer.Chatted:Connect(function(message)
    handleCommand(message)
end)

notify("Client Admin V1.0 Loaded. Type " .. prefix .. "cmd for commands.")
