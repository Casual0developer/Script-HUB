-- Forward declarations let the fling GUI coordinate with AntiFling while the
-- actual protection implementation remains with the other command helpers.
local startAntiFling
local stopAntiFling

local function pauseAntiFlingForFling()
    if not antiFling then return end
    antiFlingResumeAfterFling = true
    if stopAntiFling then stopAntiFling(true, true) end
    notify("AntiFling paused while you are flinging")
end

local function resumeAntiFlingAfterFling()
    if not antiFlingResumeAfterFling then return end
    antiFlingResumeAfterFling = false
    if startAntiFling then startAntiFling(true) end
    notify("AntiFling restored after flinging")
end

local function resumeAntiFlingWhenFlingIsFinished()
    if not FlingWorkerRunning then
        resumeAntiFlingAfterFling()
    end
end

