local function hookDeathTracking(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    -- Roblox creates a new Humanoid after respawning, so reapply the
    -- WalkSpeed previously selected with !speed.
    if desiredWalkSpeed ~= nil then
        hum.WalkSpeed = desiredWalkSpeed

        -- Some games initialize character values shortly after spawn.
        -- Reapply once more after initialization without creating a permanent loop.
        task.delay(0.5, function()
            if hum and hum.Parent and desiredWalkSpeed ~= nil then
                hum.WalkSpeed = desiredWalkSpeed
            end
        end)
    end

    hum.Died:Connect(function()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            deathPosition = hrp.Position
            notify("Death position saved. Use !back to return.")
        end
    end)
end

