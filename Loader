local function fetchServers()
    local placeId    = game.PlaceId
    local allServers = {}
    local cursor     = ""
    local maxPages   = 5
    for page = 1, maxPages do
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor and cursor ~= "" then url = url .. "&cursor=" .. cursor end
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not success or not result or not result.data then break end
        for _, server in ipairs(result.data) do table.insert(allServers, server) end
        if result.nextPageCursor and result.nextPageCursor ~= "" then
            cursor = result.nextPageCursor
        else break end
    end
    return allServers
end

